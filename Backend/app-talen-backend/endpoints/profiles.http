@baseUrl = http://localhost:3001
@accessToken =

### Create my profile
POST {{baseUrl}}/profiles/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fullName": "Juan Perez",
  "ageRange": "25-34",
  "location": "Buenos Aires",
  "currentStatus": "buscando empleo",
  "headline": "Frontend Developer Junior",
  "professionalBio": "Estoy aprendiendo React y backend con NestJS",
  "yearsExperience": 1
}

### Get my profile
GET {{baseUrl}}/profiles/me
Authorization: Bearer {{accessToken}}

### Update my profile
PATCH {{baseUrl}}/profiles/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "headline": "Full Stack Developer Junior",
  "yearsExperience": 2
}

### Update my work preferences
PATCH {{baseUrl}}/profiles/me/preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "country": "Argentina",
  "preferredModality": "HIBRIDO"
}

### Update my interested roles
PATCH {{baseUrl}}/profiles/me/interested-roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "interestedRoles": [
    "BACKEND_DEVELOPER",
    "QA_TESTER",
    "DATA_ANALYST"
  ]
}

### Recalculate my employability score
PATCH {{baseUrl}}/profiles/me/employability-score
Authorization: Bearer {{accessToken}}

### Analyze my CV from extracted text
POST {{baseUrl}}/profiles/me/cv/analyze
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "applyToProfile": false,
  "extractedText": "Juan Perez\nBackend Developer Junior\nExperiencia: 1 anio trabajando con Node.js, NestJS, PostgreSQL y Git. Busco mi primer empleo formal como developer backend. Conocimientos de APIs REST, TypeORM y testing basico."
}

### Analyze my CV from extracted text and apply missing profile fields
POST {{baseUrl}}/profiles/me/cv/analyze
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "applyToProfile": true,
  "extractedText": "Juan Perez\nBackend Developer Junior\nBuenos Aires, Argentina\nExperiencia: 1 anio con Node.js, NestJS, PostgreSQL y Git. Interesado en modalidad hibrida o remota. Busco crecer como backend developer."
}

### Analyze my CV from PDF file
POST {{baseUrl}}/profiles/me/cv/analyze
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=BoundaryCv

--BoundaryCv
Content-Disposition: form-data; name="applyToProfile"

true
--BoundaryCv
Content-Disposition: form-data; name="file"; filename="cv.pdf"
Content-Type: application/pdf

< ./cv.pdf
--BoundaryCv--
